distance = float(input("Введите расстояние (км):"))
speed = float(input("Введите скорость (км/ч):"))
fuel_consumption = float(input("Введите расход топлива (л/100 км):"))
time_in_hours = distance / speed
total_fuel = (distance / 100) * fuel_consumption
print(f"Маршрут: {distance} км, скорость {speed} км/ч")
print(f"Время в пути: {time_in_hours:.2f} часов")
print(f"Расход топлива: {fuel_consumption} л/100 км")
print(f"Общий расход: {total_fuel:.2f} литров")
